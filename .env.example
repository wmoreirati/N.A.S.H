# Copie este arquivo para ".env" e preencha com seus valores reais.
# NUNCA cometa o arquivo ".env" (com valores reais) em um repositório.

# ---------------------------------------------------------------------
# Provedor de IA
# ---------------------------------------------------------------------
# Qual modelo o N.A.S.H vai usar para conversar. Opções:
#
#   ollama  -> modelo local, gratuito, exige o Ollama instalado e rodando
#   openai  -> API da OpenAI  (exige OPENAI_API_KEY)
#   gemini  -> API do Google  (exige GEMINI_API_KEY)
#
# Atenção: o modelo local padrão é pequeno e erra contas. Para uso como
# professor de exatas, prefira "openai" ou "gemini".
AI_PROVIDER=ollama

# --- Opção 1: Ollama (local) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:1.7b

# --- Opção 2: OpenAI ---
# Chave em: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Opção 3: Google Gemini ---
# Chave em: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# ---------------------------------------------------------------------
# Servidor
# ---------------------------------------------------------------------

# Porta do servidor Flask (padrão: 5000).
PORT=5000

# "1" para modo debug (recarrega automático + mais logs), "0" para produção.
# Mantenha 0 em qualquer servidor acessível pela internet.
FLASK_DEBUG=1

# Recomendado. Chave secreta do Flask (sessões/segurança). Se vazia, o servidor
# gera uma chave temporária a cada reinício (ok para uso local).
# Gere uma com: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Quantas mensagens recentes (usuário+assistente) são enviadas como
# contexto ao modelo de IA a cada turno (padrão: 30).
MAX_HISTORY_MESSAGES=30
